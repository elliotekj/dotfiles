[core]
	excludesfile = ~/.config/git/gitignore_global
[init]
	defaultBranch = master
[user]
	name = Elliot Jackson
	email = elliot@elliotekj.com
[push]
	autoSetupRemote = true
[diff]
	external = difft
	tool = difftastic
	algorithm = patience
	compactionHeuristic = true
[difftool]
	prompt = false
[difftool "difftastic"]
	cmd = difft "$LOCAL" "$REMOTE"
[url "ssh://git@github.com/tellerhq/utls"]
	insteadOf = https://github.com/tellerhq/utls
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[remote]
	pushDefault = origin
[submodule]
	recurse = true
